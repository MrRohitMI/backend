<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/expense/edit" method="post">
      <input type="hidden" name="expenseId" value="<%=expense._id%>"/>
      <input
        type="text"
        placeholder="Enter Title"
        name="title"
        value="<%=expense.title%>"
      />
      <input
        type="number"
        placeholder="Enter Amount"
        name="amount"
        value="<%=expense.amount%>"
      />
      <input
        type="text"
        placeholder="Enter Category"
        name="category"
        value="<%=expense.category%>"
      />
      <input
        type="date"
        placeholder="date"
        name="date"
        value="<%= expense.date.toISOString().split('T')[0] %>"
      />
      <button>Submit</button>
    </form>
  </body>
</html>
