<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Product</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="bg-gray-100">
    <nav class="bg-gray-200 p-4 flex gap-5">
      <a href="/product" class="text-blue-600">Products</a>
      <a href="/create-product" class="text-blue-600">Create Product</a>
      <a href="/user/logout" class="text-red-600">Logout</a>
    </nav>
    <form
      action="/product/edit/<%= product._id %>"
      method="post"
      class="max-w-lg mx-auto mt-10 bg-white p-6 rounded shadow"
    >
      <h1 class="text-2xl font-bold mb-5">Edit Product</h1>

      <label class="block mb-2">Product Name</label>
      <input
        type="text"
        name="name"
        value="<%= product.name %>"
        class="border p-2 w-full mb-4"
        required
      />

      <label class="block mb-2">Description</label>
      <textarea name="description" class="border p-2 w-full mb-4" required>
<%= product.description %></textarea
      >
      <label class="block mb-2">Product Image URL</label>
      <input
        type="text"
        name="url"
        value="<%= product.imgUrl %>"
        class="border p-2 w-full mb-4"
        required
      />
      <label class="block mb-2">Price</label>
      <input
        type="number"
        name="price"
        value="<%= product.price %>"
        class="border p-2 w-full mb-4"
        required
      />

      <button
        type="submit"
        class="bg-blue-600 text-white p-3 rounded hover:bg-blue-700"
      >
        Update Product
      </button>
    </form>
  </body>
</html>
