<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  </head>
  <body>
    <form action="/submit" method="post" class="m-auto max-w-[400px] flex flex-col gap-3 mt-10 bg-gray-200 p-4 items-center rounded">
