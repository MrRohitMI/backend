    <div><input name="email" type="email" placeholder="Enter Email" class="p-5 h-4 border focus:ring-blue-500 focus:ring-2 rounded"/></div>  
     <div> <input name="age" type="number" placeholder="Enter Age" class="p-5 h-4 border focus:ring-blue-500 focus:ring-2 rounded"/></div>
      <div><input name="color" type="text" placeholder="Enter Favorite Color" class="p-5 h-4 border focus:ring-blue-500 focus:ring-2 rounded"/></div>
      <div>
      <button class="bg-red-600 p-3 rounded text-white font-bold">Submit</button></div>
    </form>
